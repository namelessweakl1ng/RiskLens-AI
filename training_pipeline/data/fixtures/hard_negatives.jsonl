{"text": "The interest rate is fixed for the entire term.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-4de97afa18d3e9cbdcf7db22a852e64ceedc1661d572b96a1b8f4c0fc525a86c", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "4de97afa18d3e9cbdcf7db22a852e64ceedc1661d572b96a1b8f4c0fc525a86c", "is_hard_negative": true}
{"text": "No foreclosure or prepayment penalty will apply.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-da16d5d28baea68f9c3ebb6ddb64dfcb0d4e885783e9ed94235b2f6b6b6ec4cf", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "da16d5d28baea68f9c3ebb6ddb64dfcb0d4e885783e9ed94235b2f6b6b6ec4cf", "is_hard_negative": true}
{"text": "No processing fee or administrative charge is payable.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-d457de1870863245079b5020eddc713245cdcb0f3bd5c49cd10eb6098aa52227", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "d457de1870863245079b5020eddc713245cdcb0f3bd5c49cd10eb6098aa52227", "is_hard_negative": true}
{"text": "The APR remains fixed at eight percent for this term.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-81f7bc46b77a3da160f4a3a79177a4eb12e94753493ea620ee0c0b6f70ed86b3", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "81f7bc46b77a3da160f4a3a79177a4eb12e94753493ea620ee0c0b6f70ed86b3", "is_hard_negative": true}
{"text": "The agreement will not automatically renew.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-a82a40056f9dc1345ed510dedde6642ce3c5ca68dbd33d03f7a24df53171e8a0", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "a82a40056f9dc1345ed510dedde6642ce3c5ca68dbd33d03f7a24df53171e8a0", "is_hard_negative": true}
{"text": "Coverage has no waiting period for the listed benefits.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-ac389b3df1ac21f8226fa664c5cf958690e791e60459cf3eb70000010e92af58", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "ac389b3df1ac21f8226fa664c5cf958690e791e60459cf3eb70000010e92af58", "is_hard_negative": true}
{"text": "Hospital treatment is covered without exclusion for the stated illness.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-ff8cf4714fc06540d0c531f8aecc9058e5b85513a337e78e483200d36ce38a83", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "ff8cf4714fc06540d0c531f8aecc9058e5b85513a337e78e483200d36ce38a83", "is_hard_negative": true}
{"text": "The lender shall not modify the terms without your written consent.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-5b245f92722d361ecee16537c429bfba3b823349b3a6ae7a4ad834f564559833", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "5b245f92722d361ecee16537c429bfba3b823349b3a6ae7a4ad834f564559833", "is_hard_negative": true}
{"text": "No default penalty shall apply during the agreed grace period.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-b3ba58ab09f9520734fdeb54972dd5480e0fbb841185fa4f97baa6dca3a27bc8", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "b3ba58ab09f9520734fdeb54972dd5480e0fbb841185fa4f97baa6dca3a27bc8", "is_hard_negative": true}
{"text": "The insurer has no discretion to increase the premium during the policy term.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-d66886dd4825e818c701c40752d62eb85467737ad3578d3d7ec6e7b28c49c4dc", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "d66886dd4825e818c701c40752d62eb85467737ad3578d3d7ec6e7b28c49c4dc", "is_hard_negative": true}
{"text": "Service charges are waived for the full duration of this agreement.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-06d05a4bae6455f50770c0b5593af441fbf30b782028989c36807b6745693624", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "06d05a4bae6455f50770c0b5593af441fbf30b782028989c36807b6745693624", "is_hard_negative": true}
{"text": "The borrower may repay early without any additional fee.", "label": "no_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-e9a54f262848f2de5a306de263d13d90d22de83de4f6ac8e2db24952bb134d5a", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "e9a54f262848f2de5a306de263d13d90d22de83de4f6ac8e2db24952bb134d5a", "is_hard_negative": true}
{"text": "A non-refundable processing fee is charged on disbursement.", "label": "hidden_charges", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-f8c3ec401163e8b21efb8a75e524b823f77dbb4d1d9fce1feda397a079440cb9", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "f8c3ec401163e8b21efb8a75e524b823f77dbb4d1d9fce1feda397a079440cb9", "is_hard_negative": false}
{"text": "The floating interest rate may rise following a benchmark reset.", "label": "high_interest", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-be6cc9068a4be389ed905c24533313591415f9b5a33a2d90526fe1eeea4a821d", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "be6cc9068a4be389ed905c24533313591415f9b5a33a2d90526fe1eeea4a821d", "is_hard_negative": false}
{"text": "A late payment penalty of five hundred rupees is payable.", "label": "penalty_clause", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-ca20a8a6a7ec98237ce4734435b8bb644222c1cf669bb3b942ceeb67fab5acc2", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "ca20a8a6a7ec98237ce4734435b8bb644222c1cf669bb3b942ceeb67fab5acc2", "is_hard_negative": false}
{"text": "The lender may repossess the collateral after default.", "label": "foreclosure", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-35355fb19ffa782ab3ce2ead896e6258df366628bef0d495c980e63c53832f78", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "35355fb19ffa782ab3ce2ead896e6258df366628bef0d495c980e63c53832f78", "is_hard_negative": false}
{"text": "The agreement automatically renews for twelve months unless cancelled.", "label": "automatic_renewal", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-89167b55d7eb7496aa34f594e273f1a324993078e44f0c2119339b108bab9a00", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "89167b55d7eb7496aa34f594e273f1a324993078e44f0c2119339b108bab9a00", "is_hard_negative": false}
{"text": "Hospital treatment for the listed condition is not covered.", "label": "coverage_exclusion", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-0bcc869ca4fbcad662eca606d570493a741b6a1cf76fc087030528fba91849f5", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "0bcc869ca4fbcad662eca606d570493a741b6a1cf76fc087030528fba91849f5", "is_hard_negative": false}
{"text": "A waiting period of ninety days applies before benefits commence.", "label": "waiting_period", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-825448688791dd904bd102446023e857597c25810395ae79817ccdb9587e731a", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "825448688791dd904bd102446023e857597c25810395ae79817ccdb9587e731a", "is_hard_negative": false}
{"text": "The insurer may modify the premium at its sole discretion.", "label": "unilateral_change", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-781ad148558cdc9d1964cf648b3e6495f37cbd70ad9bf0b29e46a2d0857b4d84", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "781ad148558cdc9d1964cf648b3e6495f37cbd70ad9bf0b29e46a2d0857b4d84", "is_hard_negative": false}
{"text": "The customer accepts unlimited liability for all consequential losses.", "label": "other_risk", "agreement_family": "synthetic_challenge", "source_type": "synthetic", "annotation_method": "synthetic_curated", "source_document_id": "synthetic-90ddb6ad0cf352c796746425fc05b0a6a6a9817eb5b85455628abda32e68b833", "source_organization": "RiskLens project synthetic fixture generator", "source_url": null, "retrieved_at": "2026-01-01T00:00:00+00:00", "sha256": "90ddb6ad0cf352c796746425fc05b0a6a6a9817eb5b85455628abda32e68b833", "is_hard_negative": false}
